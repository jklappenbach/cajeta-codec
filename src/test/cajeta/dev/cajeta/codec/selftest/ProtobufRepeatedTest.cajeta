package dev.cajeta.codec.selftest;

import cajeta.lang.String;
import dev.cajeta.unit.Assert;
import dev.cajeta.codec.protobuf.Protobuf;
import dev.cajeta.codec.protobuf.ProtobufCursor;
import dev.cajeta.codec.protobuf.ProtobufIndex;
import dev.cajeta.codec.protobuf.ProtobufParseException;
import dev.cajeta.codec.protobuf.ProtobufWriter;

/**
 * Unit 5 — repeated and packed fields (spec 6.1–6.8, UC-PB-3).
 */
public class ProtobufRepeatedTest {

    public ProtobufRepeatedTest() {
        return;
    }

    /** 5.1.1 — every occurrence binds into the array, in wire order. */
    @Test
    public void repeatedScalarBindsInWireOrder() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        int64[] s = [(int64) 10, (int64) 20, (int64) 30];
        m.scores = s;
        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that((int64) back.scores.count()).isEqualTo((int64) 3);
        Assert.that(back.scores[0]).isEqualTo((int64) 10);
        Assert.that(back.scores[1]).isEqualTo((int64) 20);
        Assert.that(back.scores[2]).isEqualTo((int64) 30);
        return;
    }

    /**
     * The default for a repeated numeric field is **packed** — one LEN record,
     * no matter how many elements. Field 3 declares no `packed` option, so this
     * pins the default itself rather than an explicit request.
     */
    @Test
    public void defaultIsPackedForRepeatedNumeric() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        int32[] c = [1, 2, 3, 4];
        m.counts = c;
        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());

        int32 n = 0;
        int32 i = 0;
        while (i < idx.fieldCount()) {
            if (idx.fieldNumber(i) == 3) {
                n = n + 1;
                Assert.that((int64) idx.wireType(i)).isEqualTo((int64) 2);
                Assert.that(idx.valueEnd(i) - idx.valueStart(i))
                    .isEqualTo((int64) 4);
            }
            i = i + 1;
        }
        Assert.that((int64) n).isEqualTo((int64) 1);
        return;
    }

    /**
     * `packed = false` opts back out to one tagged record per element. Field 2
     * declares it, which is the only way to get the expanded form now that
     * packed is the default.
     */
    @Test
    public void packedFalseStaysExpanded() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        int64[] s = [(int64) 1, (int64) 2, (int64) 3];
        m.scores = s;
        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());

        int32 n = 0;
        int32 i = 0;
        while (i < idx.fieldCount()) {
            if (idx.fieldNumber(i) == 2) {
                n = n + 1;
                Assert.that((int64) idx.wireType(i)).isEqualTo((int64) 0);
            }
            i = i + 1;
        }
        Assert.that((int64) n).isEqualTo((int64) 3);
        return;
    }

    /** 5.1.2 — repeated nested messages bind to an array. */
    @Test
    public void repeatedMessageBinds() {
        ProtoInnerMsg a = heap ProtoInnerMsg();
        a.x = (int64) 1;
        a.tag = "one";
        ProtoInnerMsg c = heap ProtoInnerMsg();
        c.x = (int64) 2;
        c.tag = "two";
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        ProtoInnerMsg[] items = heap ProtoInnerMsg[2];
        items[0] = #a;
        items[1] = #c;
        m.items = #items;

        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that((int64) back.items.count()).isEqualTo((int64) 2);
        Assert.that(back.items[0].x).isEqualTo((int64) 1);
        Assert.isTrue(back.items[0].tag.equals("one"));
        Assert.that(back.items[1].x).isEqualTo((int64) 2);
        Assert.isTrue(back.items[1].tag.equals("two"));
        return;
    }

    /** Repeated strings bind one element per LEN record. */
    @Test
    public void repeatedStringBinds() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        String[] tags = heap String[2];
        String t0 = "alpha";
        String t1 = "beta";
        tags[0] = t0;
        tags[1] = t1;
        m.tags = #tags;

        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that((int64) back.tags.count()).isEqualTo((int64) 2);
        Assert.isTrue(back.tags[0].equals("alpha"));
        Assert.isTrue(back.tags[1].equals("beta"));
        return;
    }

    /** 5.1.3 — an absent repeated field is empty, never null. */
    @Test
    public void absentRepeatedIsEmptyNotNull() {
        ProtobufWriter w = heap ProtobufWriter();
        w.writeVarintField(1, (int64) 5);
        int8[] b = w.toBytes();
        ProtoRepeatedMsg m = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that(m.id).isEqualTo((int64) 5);
        Assert.isTrue(m.scores != null);
        Assert.that((int64) m.scores.count()).isEqualTo((int64) 0);
        Assert.isTrue(m.counts != null);
        Assert.that((int64) m.counts.count()).isEqualTo((int64) 0);
        Assert.isTrue(m.tags != null);
        Assert.that((int64) m.tags.count()).isEqualTo((int64) 0);
        Assert.isTrue(m.items != null);
        Assert.that((int64) m.items.count()).isEqualTo((int64) 0);
        return;
    }

    /**
     * 5.1.4 — an explicitly packed field is one LEN record, whatever the
     * element count. Field 5 declares `packed = true` outright.
     */
    @Test
    public void packedWriteProducesSingleLenRecord() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        int32[] s = [1, 2, 3, 4, 5];
        m.stamps = s;
        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());

        int32 n = 0;
        int32 i = 0;
        while (i < idx.fieldCount()) {
            if (idx.fieldNumber(i) == 5) {
                n = n + 1;
                Assert.that((int64) idx.wireType(i)).isEqualTo((int64) 2);
                // Five fixed32 elements, four bytes each, in one payload.
                Assert.that(idx.valueEnd(i) - idx.valueStart(i))
                    .isEqualTo((int64) 20);
            }
            i = i + 1;
        }
        Assert.that((int64) n).isEqualTo((int64) 1);
        return;
    }

    /** 5.1.5 — a packed payload decodes back to every element. */
    @Test
    public void packedReadDecodesAllElements() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        int32[] c = [1, 300, 70000];
        m.counts = c;
        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that((int64) back.counts.count()).isEqualTo((int64) 3);
        Assert.that((int64) back.counts[0]).isEqualTo((int64) 1);
        Assert.that((int64) back.counts[1]).isEqualTo((int64) 300);
        Assert.that((int64) back.counts[2]).isEqualTo((int64) 70000);
        return;
    }

    /**
     * 5.1.6 — the same field sent **unpacked** by a peer decodes identically.
     * A conforming reader must accept either form regardless of declaration;
     * field 3 is packed by default, and this hand-writes it the other way.
     */
    @Test
    public void unpackedWireFormDecodesIdentically() {
        ProtobufWriter w = heap ProtobufWriter();
        w.writeVarintField(3, (int64) 1);
        w.writeVarintField(3, (int64) 300);
        w.writeVarintField(3, (int64) 70000);
        int8[] b = w.toBytes();
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that((int64) back.counts.count()).isEqualTo((int64) 3);
        Assert.that((int64) back.counts[0]).isEqualTo((int64) 1);
        Assert.that((int64) back.counts[1]).isEqualTo((int64) 300);
        Assert.that((int64) back.counts[2]).isEqualTo((int64) 70000);
        return;
    }

    /** The mirror: a field declared `packed = false` still reads a packed peer. */
    @Test
    public void packedWireFormDecodesForExpandedDeclaration() {
        int64[] vals = [(int64) 7, (int64) 8];
        ProtobufWriter w = heap ProtobufWriter();
        w.writePackedVarintField(2, vals, (int32) 2);
        int8[] b = w.toBytes();
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that((int64) back.scores.count()).isEqualTo((int64) 2);
        Assert.that(back.scores[0]).isEqualTo((int64) 7);
        Assert.that(back.scores[1]).isEqualTo((int64) 8);
        return;
    }

    /** Both forms of the same field number concatenate, in wire order. */
    @Test
    public void mixedPackedAndUnpackedConcatenate() {
        int64[] first = [(int64) 1, (int64) 2];
        ProtobufWriter w = heap ProtobufWriter();
        w.writePackedVarintField(2, first, (int32) 2);
        w.writeVarintField(2, (int64) 3);
        int8[] b = w.toBytes();
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that((int64) back.scores.count()).isEqualTo((int64) 3);
        Assert.that(back.scores[0]).isEqualTo((int64) 1);
        Assert.that(back.scores[1]).isEqualTo((int64) 2);
        Assert.that(back.scores[2]).isEqualTo((int64) 3);
        return;
    }

    /** 5.1.7 — a packed fixed payload that does not divide evenly is rejected. */
    @Test
    public void packedPayloadNotDivisibleRaises() {
        // Field 5 is packed fixed32: the payload must be a multiple of 4.
        int8[] six = [(int8) 1, (int8) 2, (int8) 3,
                      (int8) 4, (int8) 5, (int8) 6];
        ProtobufWriter w = heap ProtobufWriter();
        w.writeLenField(5, six, (int32) 6);
        int8[] b = w.toBytes();

        boolean caught = false;
        try {
            ProtoRepeatedMsg m = Protobuf.parse<ProtoRepeatedMsg>(
                b, (int64) b.count());
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /** The same rejection straight off the cursor. */
    @Test
    public void cursorRejectsRaggedPackedFixed32() {
        int8[] six = [(int8) 1, (int8) 2, (int8) 3,
                      (int8) 4, (int8) 5, (int8) 6];
        ProtobufWriter w = heap ProtobufWriter();
        w.writeLenField(5, six, (int32) 6);
        int8[] b = w.toBytes();
        ProtobufCursor cur = heap ProtobufCursor(b, (int64) b.count());

        boolean caught = false;
        try {
            int32[] v = cur.readRepeatedFixed32(5);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /** 5.1.8a — packed zigzag: the element encoding governs each element. */
    @Test
    public void packedZigzagRoundTrips() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        int64[] d = [(int64) 0 - (int64) 1, (int64) 0 - (int64) 2, (int64) 5];
        m.deltas = d;
        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that((int64) back.deltas.count()).isEqualTo((int64) 3);
        Assert.that(back.deltas[0]).isEqualTo((int64) 0 - (int64) 1);
        Assert.that(back.deltas[1]).isEqualTo((int64) 0 - (int64) 2);
        Assert.that(back.deltas[2]).isEqualTo((int64) 5);

        // Zigzag keeps the payload tight: three values, one byte each.
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());
        int32 i = 0;
        while (i < idx.fieldCount()) {
            if (idx.fieldNumber(i) == 4) {
                Assert.that(idx.valueEnd(i) - idx.valueStart(i))
                    .isEqualTo((int64) 3);
            }
            i = i + 1;
        }
        return;
    }

    /** 5.1.8b — packed fixed32: four bytes per element, values intact. */
    @Test
    public void packedFixed32RoundTrips() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        int32[] s = [1013, 2026, 7];
        m.stamps = s;
        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that((int64) back.stamps.count()).isEqualTo((int64) 3);
        Assert.that((int64) back.stamps[0]).isEqualTo((int64) 1013);
        Assert.that((int64) back.stamps[1]).isEqualTo((int64) 2026);
        Assert.that((int64) back.stamps[2]).isEqualTo((int64) 7);

        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());
        int32 i = 0;
        while (i < idx.fieldCount()) {
            if (idx.fieldNumber(i) == 5) {
                Assert.that(idx.valueEnd(i) - idx.valueStart(i))
                    .isEqualTo((int64) 12);
            }
            i = i + 1;
        }
        return;
    }

    /** 5.3.3 — `int8[]` is still `bytes`, not a repeated int8. */
    @Test
    public void bytesFieldIsStillBytes() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        int8[] blob = [(int8) 0x07, (int8) 0x09, (int8) 0x0B];
        m.blob = blob;
        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());

        int32 n = 0;
        int32 i = 0;
        while (i < idx.fieldCount()) {
            if (idx.fieldNumber(i) == 8) {
                n = n + 1;
                // One LEN record holding all three bytes — not three records.
                Assert.that((int64) idx.wireType(i)).isEqualTo((int64) 2);
                Assert.that(idx.valueEnd(i) - idx.valueStart(i))
                    .isEqualTo((int64) 3);
            }
            i = i + 1;
        }
        Assert.that((int64) n).isEqualTo((int64) 1);

        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());
        Assert.that((int64) back.blob.count()).isEqualTo((int64) 3);
        return;
    }

    /** Everything at once, to catch interference between the shapes. */
    @Test
    public void allRepeatedShapesRoundTripTogether() {
        ProtoRepeatedMsg m = heap ProtoRepeatedMsg();
        m.id = (int64) 99;
        int64[] s = [(int64) 4, (int64) 5];
        m.scores = s;
        int32[] c = [6, 7];
        m.counts = c;
        int64[] d = [(int64) 0 - (int64) 8];
        m.deltas = d;
        int32[] st = [9];
        m.stamps = st;
        ProtoInnerMsg one = heap ProtoInnerMsg();
        one.x = (int64) 11;
        one.tag = "z";
        ProtoInnerMsg[] items = heap ProtoInnerMsg[1];
        items[0] = #one;
        m.items = #items;

        int8[] b = Protobuf.toBytes<ProtoRepeatedMsg>(m);
        ProtoRepeatedMsg back = Protobuf.parse<ProtoRepeatedMsg>(b, (int64) b.count());

        Assert.that(back.id).isEqualTo((int64) 99);
        Assert.that((int64) back.scores.count()).isEqualTo((int64) 2);
        Assert.that((int64) back.counts.count()).isEqualTo((int64) 2);
        Assert.that(back.deltas[0]).isEqualTo((int64) 0 - (int64) 8);
        Assert.that((int64) back.stamps[0]).isEqualTo((int64) 9);
        Assert.that(back.items[0].x).isEqualTo((int64) 11);
        return;
    }
}
