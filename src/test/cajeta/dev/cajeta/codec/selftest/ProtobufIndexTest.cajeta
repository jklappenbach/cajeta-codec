package dev.cajeta.codec.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.codec.protobuf.ProtobufIndex;
import dev.cajeta.codec.protobuf.ProtobufWire;
import dev.cajeta.codec.protobuf.ProtobufWriter;

/**
 * Phase 2.1b — ProtobufIndex structural scan. Hand-encoded protobuf messages;
 * asserts per-field number/wire-type/value-bounds and fail-loud on group /
 * unknown wire types.
 */
public class ProtobufIndexTest {

    public ProtobufIndexTest() {
        return;
    }

    @Test
    public void indexesSingleVarintField() {
        // field 1, VARINT, value 150 → tag 0x08, varint 0x96 0x01
        int8[] b = [(int8) 0x08, (int8) 0x96, (int8) 0x01];
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) 3);
        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 1);
        Assert.that((int64) idx.fieldNumber(0)).isEqualTo((int64) 1);
        Assert.that((int64) idx.wireType(0)).isEqualTo((int64) 0);
        Assert.that(idx.valueStart(0)).isEqualTo((int64) 1);
        Assert.that(idx.valueEnd(0)).isEqualTo((int64) 3);
        // the value is reachable at valueStart
        Assert.that(ProtobufWire.decodeVarint(b, idx.valueStart(0)))
            .isEqualTo((int64) 150);
        return;
    }

    @Test
    public void indexesLenField() {
        // field 2, LEN "hi" → tag 0x12, len 0x02, 'h' 'i'
        int8[] b = [(int8) 0x12, (int8) 0x02, (int8) 0x68, (int8) 0x69];
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) 4);
        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 1);
        Assert.that((int64) idx.fieldNumber(0)).isEqualTo((int64) 2);
        Assert.that((int64) idx.wireType(0)).isEqualTo((int64) 2);
        // value = the payload AFTER the length prefix: bytes [2,4)
        Assert.that(idx.valueStart(0)).isEqualTo((int64) 2);
        Assert.that(idx.valueEnd(0)).isEqualTo((int64) 4);
        return;
    }

    @Test
    public void indexesTwoFields() {
        // field 1 VARINT 150, then field 2 LEN "hi"
        int8[] b = [(int8) 0x08, (int8) 0x96, (int8) 0x01,
                    (int8) 0x12, (int8) 0x02, (int8) 0x68, (int8) 0x69];
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) 7);
        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 2);
        Assert.that((int64) idx.fieldNumber(1)).isEqualTo((int64) 2);
        Assert.that((int64) idx.wireType(1)).isEqualTo((int64) 2);
        Assert.that(idx.valueStart(1)).isEqualTo((int64) 5);
        Assert.that(idx.valueEnd(1)).isEqualTo((int64) 7);
        return;
    }

    @Test
    public void indexesFixed32And64() {
        // field 5 I32 (tag 0x2D, 4 bytes), then field 6 I64 (tag 0x31, 8 bytes)
        int8[] b = [(int8) 0x2D, (int8) 1, (int8) 2, (int8) 3, (int8) 4,
                    (int8) 0x31, (int8) 1, (int8) 2, (int8) 3, (int8) 4,
                    (int8) 5, (int8) 6, (int8) 7, (int8) 8];
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) 14);
        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 2);
        Assert.that((int64) idx.wireType(0)).isEqualTo((int64) 5);   // I32
        Assert.that(idx.valueEnd(0) - idx.valueStart(0)).isEqualTo((int64) 4);
        Assert.that((int64) idx.wireType(1)).isEqualTo((int64) 1);   // I64
        Assert.that(idx.valueEnd(1) - idx.valueStart(1)).isEqualTo((int64) 8);
        return;
    }

    @Test
    public void groupWireTypeFailsLoud() {
        // field 1, wire type 3 (group start, deprecated) → tag 0x0B
        int8[] b = [(int8) 0x0B];
        Assert.assertThrows(() -> {
            ProtobufIndex.build(b, (int64) 1);
        });
        return;
    }

    @Test
    public void unknownWireTypeFailsLoud() {
        // wire type 6 (unknown) → tag (1<<3)|6 = 14 = 0x0E
        int8[] b = [(int8) 0x0E];
        Assert.assertThrows(() -> {
            ProtobufIndex.build(b, (int64) 1);
        });
        return;
    }

    // ---- Unit 2: allocation tracks field count, not message length ----

    /**
     * 2.1.1 — the corpus check. Field numbers, wire types, and value bounds are
     * exactly what they were before the allocation strategy changed. Every wire
     * type appears, and the LEN payload sits after its length prefix.
     */
    @Test
    public void indexMatchesLegacyBoundsAcrossCorpus() {
        // f1 VARINT 150 | f2 LEN "hi" | f3 I32 | f4 I64 | f5 VARINT 7
        ProtobufWriter w = heap ProtobufWriter();
        w.writeVarintField(1, (int64) 150);
        int8[] hi = [(int8) 0x68, (int8) 0x69];
        w.writeLenField(2, hi, (int32) 2);
        w.writeFixed32Field(3, 1013);
        w.writeFixed64Field(4, (int64) 171532800);
        w.writeVarintField(5, (int64) 7);
        int8[] b = w.toBytes();

        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());
        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 5);

        // f1: tag at 0, two value bytes.
        Assert.that((int64) idx.fieldNumber(0)).isEqualTo((int64) 1);
        Assert.that((int64) idx.wireType(0)).isEqualTo((int64) 0);
        Assert.that(idx.valueStart(0)).isEqualTo((int64) 1);
        Assert.that(idx.valueEnd(0)).isEqualTo((int64) 3);
        // f2: tag 3, len 4, payload [5,7) — after the length prefix.
        Assert.that((int64) idx.fieldNumber(1)).isEqualTo((int64) 2);
        Assert.that((int64) idx.wireType(1)).isEqualTo((int64) 2);
        Assert.that(idx.valueStart(1)).isEqualTo((int64) 5);
        Assert.that(idx.valueEnd(1)).isEqualTo((int64) 7);
        // f3: I32, four bytes.
        Assert.that((int64) idx.wireType(2)).isEqualTo((int64) 5);
        Assert.that(idx.valueEnd(2) - idx.valueStart(2)).isEqualTo((int64) 4);
        // f4: I64, eight bytes.
        Assert.that((int64) idx.wireType(3)).isEqualTo((int64) 1);
        Assert.that(idx.valueEnd(3) - idx.valueStart(3)).isEqualTo((int64) 8);
        // f5 closes the message exactly.
        Assert.that((int64) idx.fieldNumber(4)).isEqualTo((int64) 5);
        Assert.that(idx.valueEnd(4)).isEqualTo((int64) b.count());
        // Each field begins where the previous ended.
        Assert.that(idx.valueEnd(0) + (int64) 2).isEqualTo(idx.valueStart(1));
        return;
    }

    /** 2.1.2 — more fields than the initial allocation holds, indexed in full. */
    @Test
    public void indexGrowsBeyondInitialCapacity() {
        ProtobufWriter w = heap ProtobufWriter();
        int32 i = 0;
        while (i < 300) {
            w.writeVarintField(i + 1, (int64) (i * 2));
            i = i + 1;
        }
        int8[] b = w.toBytes();
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());

        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 300);
        // First, an arbitrary middle, and last — all intact after the growth.
        Assert.that((int64) idx.fieldNumber(0)).isEqualTo((int64) 1);
        Assert.that((int64) idx.fieldNumber(150)).isEqualTo((int64) 151);
        Assert.that((int64) idx.fieldNumber(299)).isEqualTo((int64) 300);
        Assert.that(idx.valueEnd(299)).isEqualTo((int64) b.count());
        // Values still decode at the recorded bounds.
        Assert.that(ProtobufWire.decodeVarint(b, idx.valueStart(150)))
            .isEqualTo((int64) 300);
        return;
    }

    /**
     * 2.1.3 — a big message with few fields allocates a small index. The old
     * strategy took one slot per input byte across four arrays (24 bytes of
     * index per message byte); this asserts allocation follows field count.
     */
    @Test
    public void largeMessageIndexIsProportionalToFieldCount() {
        int8[] blob = heap int8[1000];
        int32 i = 0;
        while (i < 1000) {
            blob[i] = (int8) (i & 0x7F);
            i = i + 1;
        }
        ProtobufWriter w = heap ProtobufWriter();
        w.writeLenField(1, blob, (int32) 1000);
        w.writeVarintField(2, (int64) 42);
        int8[] b = w.toBytes();

        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());
        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 2);
        // Two fields — the index stays at its initial allocation, nowhere near
        // the ~1005 slots the message length would have demanded.
        Assert.isTrue(idx.capacity() <= 16);
        Assert.isTrue((int64) idx.capacity() < (int64) b.count() / (int64) 10);
        return;
    }

    /** Allocation never drops below what is in use, however the growth runs. */
    @Test
    public void capacityCoversFieldCount() {
        ProtobufWriter w = heap ProtobufWriter();
        int32 i = 0;
        while (i < 33) {
            w.writeVarintField(1, (int64) i);
            i = i + 1;
        }
        int8[] b = w.toBytes();
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) b.count());
        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 33);
        Assert.isTrue(idx.capacity() >= idx.fieldCount());
        return;
    }

    /** An empty message indexes to zero fields without allocating a run. */
    @Test
    public void emptyMessageIndexesToNoFields() {
        int8[] b = heap int8[0];
        ProtobufIndex idx = ProtobufIndex.build(b, (int64) 0);
        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 0);
        Assert.isTrue(idx.capacity() >= 0);
        return;
    }
}
