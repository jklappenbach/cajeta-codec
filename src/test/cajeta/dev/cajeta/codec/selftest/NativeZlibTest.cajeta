package dev.cajeta.codec.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.codec.compress.NativeZlib;
import dev.cajeta.codec.compress.Gzip;
import dev.cajeta.codec.compress.Zlib;
import dev.cajeta.codec.compress.Deflate;
import dev.cajeta.codec.compress.DeflateException;
import cajeta.lang.String;

/**
 * Native zlib backend (units 1–2) — proves the `@Native` → vendored-static-zlib
 * link plus the one-shot compress/inflate shims for raw DEFLATE (RFC 1951),
 * zlib (RFC 1950), and gzip (RFC 1952). Round-trips are byte-exact, the output
 * interoperates with the pure-cajeta decoders, and malformed input raises a
 * catchable [`DeflateException`](../compress/DeflateException.cajeta). Requires
 * `native/build.sh` to have produced `native/<platform>/libcajeta_zlib.a` with
 * CAJETA_NATIVE_PATH pointing at the project `native/` dir.
 */
public class NativeZlibTest {

    public NativeZlibTest() {
        return;
    }

    // A compressible test buffer: a repeating low-entropy pattern.
    static #int8[] payload(int64 n) {
        int8[] b = heap int8[n];
        int64 i = (int64) 0;
        while (i < n) {
            b[i] = (int8) ((i % (int64) 64) + (int64) 32);
            i = i + 1;
        }
        return #b;
    }

    // True iff a[0..n) == b[0..n) and both are at least n long.
    static boolean sameBytes(int8[] a, int8[] b, int64 n) {
        if ((int64) a.count() < n) { return false; }
        if ((int64) b.count() < n) { return false; }
        int64 i = (int64) 0;
        while (i < n) {
            if (a[i] != b[i]) { return false; }
            i = i + 1;
        }
        return true;
    }

    @Test
    public void crc32MatchesReference() {
        // crc32("hello world") == 0x0D4A1185 == 222957957.
        String s = "hello world";
        int8[] b = s.toBytes();
        int64 c = NativeZlib.crc32(b, (int64) s.byteLength());
        Assert.isTrue(c == (int64) 222957957);
        return;
    }

    @Test
    public void crc32MatchesCajeta() {
        // Native and the pure-cajeta CRC agree over a non-trivial buffer.
        int8[] in = heap int8[517];
        int32 i = 0;
        while (i < 517) { in[i] = (int8) ((i * 37 + 11) & 0xFF); i = i + 1; }
        int64 nat = NativeZlib.crc32(in, (int64) 517);
        int64 caj = Gzip.crc32(in, (int64) 517);
        Assert.isTrue(nat == caj);
        return;
    }

    @Test
    public void adler32MatchesCajeta() {
        int8[] in = heap int8[517];
        int32 i = 0;
        while (i < 517) { in[i] = (int8) ((i * 29 + 7) & 0xFF); i = i + 1; }
        int64 nat = NativeZlib.adler32(in, (int64) 517);
        int64 caj = Zlib.adler32(in, (int64) 517);
        Assert.isTrue(nat == caj);
        return;
    }

    @Test
    public void rawRoundTrips() {
        int64 n = (int64) 4096;
        int8[] in = NativeZlibTest.payload(n);
        int8[] comp = NativeZlib.deflate(in, n, 6);
        int8[] out = NativeZlib.inflate(comp, (int64) comp.count(), n);
        Assert.isTrue((int64) out.count() == n);
        Assert.isTrue(NativeZlibTest.sameBytes(in, out, n));
        return;
    }

    @Test
    public void rawDecodesUnderCajeta() {
        // Native raw DEFLATE output must inflate under the pure-cajeta decoder.
        int64 n = (int64) 2000;
        int8[] in = NativeZlibTest.payload(n);
        int8[] comp = NativeZlib.deflate(in, n, 9);
        int8[] out = Deflate.inflate(comp, (int64) comp.count(), n);
        Assert.isTrue(NativeZlibTest.sameBytes(in, out, n));
        return;
    }

    @Test
    public void zlibRoundTrips() {
        int64 n = (int64) 3000;
        int8[] in = NativeZlibTest.payload(n);
        int8[] comp = NativeZlib.zlibCompress(in, n, 6);
        int8[] out = NativeZlib.zlibDecompress(comp, (int64) comp.count(), n);
        Assert.isTrue(NativeZlibTest.sameBytes(in, out, n));
        // Interop: the pure-cajeta zlib decoder decodes native zlib output.
        int8[] caj = Zlib.decompress(comp, (int64) comp.count(), n);
        Assert.isTrue(NativeZlibTest.sameBytes(in, caj, n));
        return;
    }

    @Test
    public void gzipRoundTrips() {
        int64 n = (int64) 3000;
        int8[] in = NativeZlibTest.payload(n);
        int8[] comp = NativeZlib.gzipCompress(in, n, 6);
        int8[] out = NativeZlib.gzipDecompress(comp, (int64) comp.count());
        Assert.isTrue(NativeZlibTest.sameBytes(in, out, n));
        // Interop: the pure-cajeta gzip decoder decodes native gzip output.
        int8[] caj = Gzip.decompress(comp, (int64) comp.count());
        Assert.isTrue(NativeZlibTest.sameBytes(in, caj, n));
        return;
    }

    @Test
    public void nativeDecodesCajetaGzip() {
        // The reverse interop: native inflates a pure-cajeta gzip member.
        int64 n = (int64) 2500;
        int8[] in = NativeZlibTest.payload(n);
        int8[] comp = Gzip.compress(in, n, 6);
        int8[] out = NativeZlib.gzipDecompress(comp, (int64) comp.count());
        Assert.isTrue(NativeZlibTest.sameBytes(in, out, n));
        return;
    }

    @Test
    public void levelsHonored() {
        // Level 9 must not produce a larger stream than level 1 on
        // compressible data, and both must round-trip.
        int64 n = (int64) 8000;
        int8[] in = NativeZlibTest.payload(n);
        int8[] c1 = NativeZlib.deflate(in, n, 1);
        int8[] c9 = NativeZlib.deflate(in, n, 9);
        Assert.isTrue((int64) c9.count() <= (int64) c1.count());
        int8[] o1 = NativeZlib.inflate(c1, (int64) c1.count(), n);
        int8[] o9 = NativeZlib.inflate(c9, (int64) c9.count(), n);
        Assert.isTrue(NativeZlibTest.sameBytes(in, o1, n));
        Assert.isTrue(NativeZlibTest.sameBytes(in, o9, n));
        return;
    }

    @Test
    public void emptyRoundTrips() {
        int8[] in = heap int8[0];
        int8[] comp = NativeZlib.deflate(in, (int64) 0, 6);
        int8[] out = NativeZlib.inflate(comp, (int64) comp.count(), (int64) 0);
        Assert.isTrue((int64) out.count() == (int64) 0);
        return;
    }

    @Test
    public void truncatedRaises() {
        // A valid raw stream cut short must raise, not crash.
        int64 n = (int64) 2000;
        int8[] in = NativeZlibTest.payload(n);
        int8[] comp = NativeZlib.deflate(in, n, 6);
        int64 half = (int64) comp.count() / (int64) 2;
        boolean caught = false;
        try {
            int8[] out = NativeZlib.inflate(comp, half, n);
        } catch (DeflateException e) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    @Test
    public void corruptGzipRaises() {
        // Garbage bytes are not a gzip member.
        int8[] junk = heap int8[40];
        int32 i = 0;
        while (i < 40) { junk[i] = (int8) ((i * 13 + 5) & 0xFF); i = i + 1; }
        boolean caught = false;
        try {
            int8[] out = NativeZlib.gzipDecompress(junk, (int64) 40);
        } catch (DeflateException e) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }
}
