package dev.cajeta.codec.selftest;

import dev.cajeta.unit.Assert;
import dev.cajeta.codec.protobuf.Protobuf;
import dev.cajeta.codec.protobuf.ProtobufCursor;
import dev.cajeta.codec.protobuf.ProtobufIndex;
import dev.cajeta.codec.protobuf.ProtobufParseException;
import dev.cajeta.codec.protobuf.ProtobufWriter;

/**
 * Unit 1 — bounds-safe, fail-loud parsing (spec 2.1–2.9). Every malformed or
 * truncated input must raise `ProtobufParseException` carrying the byte offset
 * of the defect. None may reach an array access outside the buffer.
 *
 * Before this unit, `[0x08, 0x96]` (a VARINT whose continuation bit is set on
 * the last byte in the message) walked off the end of the array and aborted the
 * process; a LEN field declaring more payload than the buffer holds was
 * accepted outright, yielding value bounds past the end.
 */
public class ProtobufBoundsTest {

    public ProtobufBoundsTest() {
        return;
    }

    // A well-formed three-field message, reused as the truncation subject:
    // field 1 VARINT 150, field 2 LEN "hi", field 3 VARINT 7.
    static #int8[] validMessage() {
        int8[] b = [(int8) 0x08, (int8) 0x96, (int8) 0x01,
                    (int8) 0x12, (int8) 0x02, (int8) 0x68, (int8) 0x69,
                    (int8) 0x18, (int8) 0x07];
        return #b;
    }

    // A real truncation: the first `k` bytes copied into their own array, so an
    // overrun hits the end of the allocation rather than reading later bytes
    // that happen to still be there.
    static #int8[] prefix(int8[] src, int32 k) {
        int8[] out = heap int8[k];
        int32 i = 0;
        while (i < k) {
            out[i] = src[i];
            i = i + 1;
        }
        return #out;
    }

    /** 1.1.1 — a varint whose continuation bit is set on the last byte in `n`. */
    @Test
    public void truncatedVarintRaises() {
        // tag 0x08 (field 1, VARINT), then 0x96 — continuation set, nothing follows.
        int8[] b = [(int8) 0x08, (int8) 0x96];
        boolean caught = false;
        try {
            ProtobufIndex idx #= ProtobufIndex.build(b, (int64) 2);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /** 1.1.2 — a varint longer than the ten bytes a 64-bit value can occupy. */
    @Test
    public void overlongVarintRaises() {
        // Ten continuation bytes then a terminator: an 11-byte varint.
        int8[] b = [(int8) 0x80, (int8) 0x80, (int8) 0x80, (int8) 0x80,
                    (int8) 0x80, (int8) 0x80, (int8) 0x80, (int8) 0x80,
                    (int8) 0x80, (int8) 0x80, (int8) 0x01];
        boolean caught = false;
        try {
            ProtobufIndex idx #= ProtobufIndex.build(b, (int64) 11);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /** 1.1.3 — a LEN field declaring more payload than the buffer holds. */
    @Test
    public void lenBeyondBufferRaises() {
        // tag 0x12 (field 2, LEN), length 0x64 = 100, but only 2 payload bytes.
        int8[] b = [(int8) 0x12, (int8) 0x64, (int8) 0x68, (int8) 0x69];
        boolean caught = false;
        try {
            ProtobufIndex idx #= ProtobufIndex.build(b, (int64) 4);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /** 1.1.4a — an I32 field with fewer than four bytes remaining. */
    @Test
    public void truncatedFixed32Raises() {
        // tag 0x0D (field 1, I32), then only two of the four bytes.
        int8[] b = [(int8) 0x0D, (int8) 0x01, (int8) 0x02];
        boolean caught = false;
        try {
            ProtobufIndex idx #= ProtobufIndex.build(b, (int64) 3);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /** 1.1.4b — an I64 field with fewer than eight bytes remaining. */
    @Test
    public void truncatedFixed64Raises() {
        // tag 0x09 (field 1, I64), then only three of the eight bytes.
        int8[] b = [(int8) 0x09, (int8) 0x01, (int8) 0x02, (int8) 0x03];
        boolean caught = false;
        try {
            ProtobufIndex idx #= ProtobufIndex.build(b, (int64) 4);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /** 1.1.5 — field number 0 is not legal protobuf; it means lost sync. */
    @Test
    public void zeroFieldNumberRaises() {
        // tag 0x00 → field number 0, wire type VARINT.
        int8[] b = [(int8) 0x00, (int8) 0x01];
        boolean caught = false;
        try {
            ProtobufIndex idx #= ProtobufIndex.build(b, (int64) 2);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /** A declared length longer than the array itself is rejected, not trusted. */
    @Test
    public void lengthBeyondArrayRaises() {
        int8[] b #= ProtobufBoundsTest.validMessage();
        boolean caught = false;
        try {
            ProtobufIndex idx #= ProtobufIndex.build(b, (int64) 900);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /**
     * 1.1.6 — the systematic sweep. Every proper prefix of a well-formed
     * message either parses cleanly or raises; none aborts the process. That
     * this test returns at all is the assertion.
     */
    @Test
    public void everyPrefixOfAValidMessageRaisesOrParses() {
        int8[] full #= ProtobufBoundsTest.validMessage();
        int32 n = (int32) full.count();
        int32 accounted = 0;
        int32 k = 1;
        while (k < n) {
            int8[] p #= ProtobufBoundsTest.prefix(full, k);
            try {
                ProtobufIndex idx #= ProtobufIndex.build(p, (int64) k);
                accounted = accounted + 1;      // a clean parse of a short prefix
            } catch (ProtobufParseException pe) {
                accounted = accounted + 1;      // rejected, as it should be
            }
            k = k + 1;
        }
        // Every prefix reached one of the two outcomes — no abort, no fallthrough.
        Assert.that((int64) accounted).isEqualTo((int64) (n - 1));
        return;
    }

    /** 1.1.7 — the exception points at the byte where the defect begins. */
    @Test
    public void exceptionCarriesDefectPosition() {
        // The value varint of field 1 starts at offset 1 and is truncated there.
        int8[] b = [(int8) 0x08, (int8) 0x96];
        int64 pos = (int64) 0 - (int64) 1;
        try {
            ProtobufIndex idx #= ProtobufIndex.build(b, (int64) 2);
        } catch (ProtobufParseException pe) {
            pos = pe.position;
        }
        Assert.that(pos).isEqualTo((int64) 1);
        return;
    }

    /** 1.1.7b — a LEN overrun reports the record's start offset. */
    @Test
    public void lenOverrunReportsRecordStart() {
        // Field 1 VARINT occupies [0,3); the bad LEN record starts at offset 3.
        int8[] b = [(int8) 0x08, (int8) 0x96, (int8) 0x01,
                    (int8) 0x12, (int8) 0x64, (int8) 0x68];
        int64 pos = (int64) 0 - (int64) 1;
        try {
            ProtobufIndex idx #= ProtobufIndex.build(b, (int64) 6);
        } catch (ProtobufParseException pe) {
            pos = pe.position;
        }
        Assert.that(pos).isEqualTo((int64) 3);
        return;
    }

    /** 1.1.8 — bytes handed back by an accepted index lie inside the buffer. */
    @Test
    public void cursorReadsStayInBuffer() {
        int8[] b #= ProtobufBoundsTest.validMessage();
        ProtobufCursor cur = heap ProtobufCursor(b, (int64) b.count());
        int8[] payload #= cur.readBytes(cur.slotOf(2));
        Assert.that((int64) payload.count()).isEqualTo((int64) 2);
        int8 p0 = payload[0];
        int8 p1 = payload[1];
        Assert.that((int64) (((int32) p0) & 0xFF)).isEqualTo((int64) 0x68);
        Assert.that((int64) (((int32) p1) & 0xFF)).isEqualTo((int64) 0x69);
        return;
    }

    /**
     * Spec 2.10 — a truncated length-delimited **stream** is rejected.
     *
     * The single-message index was hardened in unit 1, but `parse<T[]>` frames
     * its own records in synthesized code, which read frame lengths unbounded
     * and then allocated from a length already past the end. A journal cut
     * short by a closed socket walked off the buffer. Found while writing the
     * repeated-field emit, which sits in the same file.
     */
    @Test
    public void truncatedDelimitedStreamRaises() {
        ProtobufWriter inner = heap ProtobufWriter();
        inner.writeVarintField(1, (int64) 10);
        inner.writeVarintField(4, (int64) 1);
        int8[] frame #= inner.toBytes();

        ProtobufWriter s = heap ProtobufWriter();
        s.writeDelimited(frame, (int32) frame.count());
        s.writeDelimited(frame, (int32) frame.count());
        int8[] full #= s.toBytes();

        // Lop off the tail of the second frame — its header still promises
        // more bytes than the buffer now holds.
        int32 cutLen = (int32) full.count() - 2;
        int8[] cut #= ProtobufBoundsTest.prefix(full, cutLen);

        boolean caught = false;
        try {
            ProtoScalarMsg[] msgs #= Protobuf.parse<ProtoScalarMsg[]>(
                cut, (int64) cutLen);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        Assert.isTrue(caught);
        return;
    }

    /** The intact stream still parses — the check rejects only real overruns. */
    @Test
    public void intactDelimitedStreamStillParses() {
        ProtobufWriter inner = heap ProtobufWriter();
        inner.writeVarintField(1, (int64) 10);
        int8[] frame #= inner.toBytes();
        ProtobufWriter s = heap ProtobufWriter();
        s.writeDelimited(frame, (int32) frame.count());
        s.writeDelimited(frame, (int32) frame.count());
        int8[] full #= s.toBytes();

        ProtoScalarMsg[] msgs #= Protobuf.parse<ProtoScalarMsg[]>(
            full, (int64) full.count());
        Assert.that((int64) msgs.count()).isEqualTo((int64) 2);
        Assert.that(msgs[0].id).isEqualTo((int64) 10);
        return;
    }

    /** 1.1.9 — the well-formed path is untouched by the hardening. */
    @Test
    public void wellFormedMessageStillIndexesUnchanged() {
        int8[] b #= ProtobufBoundsTest.validMessage();
        ProtobufIndex idx #= ProtobufIndex.build(b, (int64) b.count());
        Assert.that((int64) idx.fieldCount()).isEqualTo((int64) 3);
        Assert.that((int64) idx.fieldNumber(0)).isEqualTo((int64) 1);
        Assert.that((int64) idx.fieldNumber(1)).isEqualTo((int64) 2);
        Assert.that((int64) idx.fieldNumber(2)).isEqualTo((int64) 3);
        Assert.that(idx.valueStart(1)).isEqualTo((int64) 5);
        Assert.that(idx.valueEnd(1)).isEqualTo((int64) 7);
        return;
    }
}
