package dev.cajeta.codec.selftest;

import cajeta.lang.String;
import dev.cajeta.codec.protobuf.ProtoField;

/**
 * Unit 5 test fixture — one field per repeated shape.
 *
 * Packed encoding is one LEN record holding the concatenated values, instead of
 * one tagged record per value. A repeated numeric field is packed **by
 * default** — matching proto3 and edition 2023 — and `packed = false` opts back
 * out. Reading accepts either form regardless of what is declared, because a
 * conforming peer may send either.
 *
 * The three packing states each have a field here, so the default is covered by
 * a test rather than by inspection:
 *
 *   1: id      int64            scalar, for company
 *   2: scores  int64[]          packed = false — the explicit opt-out
 *   3: counts  int32[]          no option — packed by default
 *   4: deltas  int64[]          zigzag, no option — packed by default
 *   5: stamps  int32[]          fixed32, packed = true — explicit
 *   6: tags    String[]         repeated LEN — never packed, one per element
 *   7: items   ProtoInnerMsg[]  repeated nested message — never packed
 *   8: blob    int8[]           still `bytes`, NOT a repeated int8
 */
public class ProtoRepeatedMsg {
    @ProtoField(1) public int64 id;
    @ProtoField(value = 2, packed = false) public int64[] scores;
    @ProtoField(3) public int32[] counts;
    @ProtoField(value = 4, encoding = "zigzag") public int64[] deltas;
    @ProtoField(value = 5, encoding = "fixed", packed = true) public int32[] stamps;
    @ProtoField(6) public String[] tags;
    @ProtoField(7) public ProtoInnerMsg[] items;
    @ProtoField(8) public int8[] blob;

    public ProtoRepeatedMsg() {
        this.id = (int64) 0;
        this.scores = null;
        this.counts = null;
        this.deltas = null;
        this.stamps = null;
        this.tags = null;
        this.items = null;
        this.blob = null;
    }
}
