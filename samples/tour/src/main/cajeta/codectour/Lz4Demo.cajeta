package codectour;

import cajeta.lang.String;
import dev.cajeta.codec.compress.Lz4;

// dev.cajeta.codec.compress.Lz4 — the LZ4 block format: fastest of the block
// codecs, no entropy stage.
//
//   Lz4.compress(src, n)             -> fresh int8[]
//   Lz4.decompress(src, n, destLen)  -> fresh int8[]
//
// Unlike Snappy, the raw LZ4 *block* format stores no uncompressed length:
// the CONTAINER owns that metadata. This demo models the contract the way
// Parquet/ORC page headers do — store (uncompressedSize, block), decode
// from the pair. Like Snappy, the raw block does no integrity checking of
// its own; framing and checksums are the container's job (see SnappyDemo's
// header and AvroDemo's per-block CRC).
public class Lz4Demo extends DemoClass {

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- dev.cajeta.codec.compress.Lz4: fastest block codec --");

        // The same shape as SnappyDemo's payload: a PLAIN int32 column page.
        int8[] page = heap int8[256];
        int32 i = 0;
        while (i < 64) {
            int32 v = 2040 + ((i * 5) % 11);
            int32 base = i * 4;
            page[base] = (int8) (v & 0xFF);
            page[base + 1] = (int8) ((v >> 8) & 0xFF);
            page[base + 2] = (int8) ((v >> 16) & 0xFF);
            page[base + 3] = (int8) ((v >> 24) & 0xFF);
            i = i + 1;
        }
        int64 pageLen = (int64) 256;

        // The container's page entry: (uncompressedSize, compressedBlock).
        // Writing side records BOTH — the block alone is not decodable.
        int8[] block #= Lz4.compress(page, pageLen);
        System.stdout.println("  page entry: size=" + pageLen + ", block="
            + block.count() + " bytes");

        // Reading side: the recorded size supplies destLen exactly.
        int8[] out #= Lz4.decompress(block, (int64) block.count(), pageLen);
        this.check(this.sameBytes(page, out),
            "lz4 round-trips the page (container-supplied destLen)");
    }
}
