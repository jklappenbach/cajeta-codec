package codectour;

import cajeta.lang.String;
import dev.cajeta.codec.protobuf.Protobuf;
import dev.cajeta.codec.protobuf.ProtoField;
import dev.cajeta.codec.protobuf.ProtobufWriter;
import dev.cajeta.codec.protobuf.ProtobufCursor;
import dev.cajeta.codec.protobuf.ProtobufIndex;
import dev.cajeta.codec.protobuf.ProtobufWire;
import dev.cajeta.codec.protobuf.ProtobufParseException;

// dev.cajeta.codec.protobuf — Protocol Buffers, the library's flagship format,
// and the first walk through its staged-access convention: the type in your
// hand names the pipeline stage.
//
//   Protobuf.parse<T> / toBytes<T>   typed facade — annotate a class with
//                                    @ProtoField(N), get whole-message binding
//   ProtobufCursor                   lazy projection — decode only the fields
//                                    you touch, skip the rest
//   ProtobufIndex                    field map — (number, wire type, byte span)
//                                    per field, values still undecoded
//   ProtobufWire                     the raw vocabulary — tags, varints
//
// Every stage reads the same wire bytes; you pick the shallowest stage that
// answers your question. Malformed input raises ProtobufParseException
// (with the byte position) — never a crash.
//
// The scenario: an order-entry event, the message a matching engine journals
// for every accepted order.

// support: the wire message. @ProtoField(N) assigns the protobuf field
// number; the encoder infers the wire type from the cajeta type (int64/
// int32/boolean -> VARINT, String/int8[]/message -> LEN). The no-arg ctor
// sets the defaults a parse keeps when a field is absent on the wire.
public class OrderEvent {
    @ProtoField(1) public int64 orderId;
    @ProtoField(2) public String symbol;
    @ProtoField(3) public boolean buy;
    @ProtoField(4) public int32 quantity;
    @ProtoField(5) public int64 priceCents;

    public OrderEvent() {
        this.orderId = (int64) 0;
        this.symbol = null;
        this.buy = false;
        this.quantity = 0;
        this.priceCents = (int64) 0;
    }
}

// support: a message whose fields exercise the `encoding` option. deltaC swings
// negative, so it is sint32 (zigzag); observedAt is a full-range epoch value
// with no small-number bias, so fixed64 costs less than a varint would.
public class TempDelta {
    @ProtoField(1) public int64 sensorId;
    @ProtoField(value = 2, encoding = "zigzag") public int32 deltaC;
    @ProtoField(value = 3, encoding = "fixed") public int64 observedAt;
    // protobuf `double` — wire type I64 carrying raw IEEE-754 bits.
    @ProtoField(4) public float64 celsius;

    public TempDelta() {
        this.sensorId = (int64) 0;
        this.deltaC = 0;
        this.observedAt = (int64) 0;
        this.celsius = (float64) 0.0;
    }
}

// support: repeated fields. `samples` is packed — one LEN record for the whole
// run; `raw` is left unpacked, one tagged record per value. Both are legal
// protobuf and each side reads the other, so the choice is about size.
public class SensorRun {
    @ProtoField(1) public int64 sensorId;
    @ProtoField(value = 2, packed = true) public int32[] samples;
    @ProtoField(3) public int64[] raw;

    public SensorRun() {
        this.sensorId = (int64) 0;
        this.samples = null;
        this.raw = null;
    }
}

public class ProtobufDemo extends DemoClass {

    public void execute() {
        System.stdout.println("");
        System.stdout.println("-- dev.cajeta.codec.protobuf: typed facade, cursor, index --");

        // 1. The typed round-trip — the entry point almost every user wants.
        //    toBytes<T> walks the annotated fields; parse<T> binds them back.
        OrderEvent e = heap OrderEvent();
        e.orderId = (int64) 88231;
        e.symbol = "ACME";
        e.buy = true;
        e.quantity = 250;
        e.priceCents = (int64) 1999;
        int8[] wire = Protobuf.toBytes<OrderEvent>(e);
        System.stdout.println("  order 88231 -> " + wire.count() + " wire bytes");
        OrderEvent back = Protobuf.parse<OrderEvent>(wire, (int64) wire.count());
        this.check(back.orderId == (int64) 88231 && back.symbol.equals("ACME"),
            "typed round-trip preserves id and symbol");
        this.check(back.buy && back.quantity == 250
            && back.priceCents == (int64) 1999,
            "typed round-trip preserves side, quantity, price");

        // 2. A stream of messages: T[] frames each event with a varint length
        //    prefix (writeDelimited under the hood) — the journal file shape.
        OrderEvent[] batch = heap OrderEvent[2];
        OrderEvent e0 = heap OrderEvent();
        e0.orderId = (int64) 88232;
        e0.symbol = "GLOBEX";
        e0.quantity = 75;
        batch[0] = e0;
        OrderEvent e1 = heap OrderEvent();
        e1.orderId = (int64) 88233;
        e1.symbol = "INITECH";
        e1.buy = true;
        e1.quantity = 30;
        batch[1] = e1;
        int8[] journal = Protobuf.toBytes<OrderEvent[]>(batch);
        OrderEvent[] replay = Protobuf.parse<OrderEvent[]>(
            journal, (int64) journal.count());
        this.check((int64) replay.count() == (int64) 2
            && replay[0].orderId == (int64) 88232
            && replay[1].symbol.equals("INITECH"),
            "delimited stream replays both events in order");

        // 3. Wire-format compatibility: bytes built with the manual writer
        //    parse through the typed facade. This is how you interoperate
        //    with a peer that has no cajeta classes — and it shows protobuf's
        //    absent-field contract: fields 3-5 are never written, so the
        //    parse keeps the constructor defaults (false, 0, 0).
        ProtobufWriter w = heap ProtobufWriter();
        w.writeVarintField(1, (int64) 90001);
        String sym = "HOOLI";
        int8[] symBytes = sym.toBytes();
        w.writeLenField(2, symBytes, (int32) symBytes.count());
        int8[] partial = w.toBytes();
        OrderEvent sparse = Protobuf.parse<OrderEvent>(
            partial, (int64) partial.count());
        this.check(sparse.orderId == (int64) 90001 && sparse.symbol.equals("HOOLI"),
            "hand-written wire bytes bind through parse<T>");
        this.check(!sparse.buy && sparse.quantity == 0
            && sparse.priceCents == (int64) 0,
            "absent wire fields keep the constructor defaults");

        // 4. ProtobufCursor — lazy projection. A risk checker that only needs
        //    the quantity decodes ONE field; symbol's bytes are never touched.
        //    slotOf finds the field by number; has() probes absence.
        ProtobufCursor cur = heap ProtobufCursor(wire, (int64) wire.count());
        int32 qtySlot = cur.slotOf(4);
        System.stdout.println("  cursor: " + cur.fieldCount()
            + " fields, quantity (field 4) in slot " + qtySlot);
        this.check(cur.readVarint(qtySlot) == (int64) 250,
            "cursor projects a single varint field");
        int32 symSlot = cur.slotOf(2);
        int8[] symRaw = cur.readBytes(symSlot);
        int8[] symWant = e.symbol.toBytes();
        this.check(this.sameBytes(symRaw, symWant),
            "cursor hands back a LEN field's payload bytes");
        this.check(!cur.has(9) && cur.slotOf(9) == 0 - 1,
            "absent field number probes as missing, not as an error");

        // 5. Fixed-width fields: proto fixed32/fixed64 (little-endian) trade
        //    varint compactness for constant-time size — the shape sensor
        //    feeds use. Written manually, read back through the cursor.
        ProtobufWriter fw = heap ProtobufWriter();
        fw.writeFixed32Field(1, 1013);              // millibars, fixed32
        fw.writeFixed64Field(2, (int64) 171532800); // epoch seconds, fixed64
        int8[] fixed = fw.toBytes();
        ProtobufCursor fcur = heap ProtobufCursor(fixed, (int64) fixed.count());
        int32 f32Slot = fcur.slotOf(1);
        int32 f64Slot = fcur.slotOf(2);
        this.check(fcur.readFixed32(f32Slot) == 1013
            && fcur.readFixed64(f64Slot) == (int64) 171532800,
            "fixed32/fixed64 fields round-trip through writer and cursor");

        // 6. ProtobufIndex + ProtobufWire — the bottom of the stack. build()
        //    maps every field to (number, wire type, value byte span) without
        //    decoding a single value; ProtobufWire then decodes exactly the
        //    span you ask for. orderId=88231 is field 1, VARINT.
        ProtobufIndex idx = ProtobufIndex.build(wire, (int64) wire.count());
        this.check(idx.fieldCount() == 5,
            "index maps all five fields of the order event");
        // The index sizes itself to the field count, not the message length —
        // so projecting two fields out of a megabyte-payload message costs an
        // index measured in fields, not in megabytes.
        this.check(idx.capacity() >= idx.fieldCount(),
            "index capacity covers the fields it holds");
        this.check(idx.fieldNumber(0) == 1
            && idx.wireType(0) == ProtobufWire.wireVarint()
            && idx.wireType(1) == ProtobufWire.wireLen(),
            "index reports field numbers and wire types");
        this.check(ProtobufWire.decodeVarint(wire, idx.valueStart(0)) == (int64) 88231,
            "wire-level decode at the index's value span");
        // The first tag byte itself: 0x08 = field 1, wire type VARINT.
        int64 tag = ProtobufWire.decodeVarint(wire, (int64) 0);
        this.check(ProtobufWire.tagFieldNumber(tag) == 1
            && ProtobufWire.tagWireType(tag) == ProtobufWire.wireVarint(),
            "a tag splits into field number and wire type");

        // 7. Malformed input fails loud. Wire type 3 (group start) is
        //    deprecated and unsupported: tag 0x0B raises
        //    ProtobufParseException carrying the byte position.
        int8[] junk = [ (int8) 0x0B ];
        boolean raised = false;
        try {
            ProtobufIndex bad = ProtobufIndex.build(junk, (int64) 1);
        } catch (ProtobufParseException pe) {
            raised = true;
        }
        this.check(raised, "corrupt wire input raises ProtobufParseException");

        // 8. Truncation is the malformed input you actually meet — a message
        //    cut short by a closed socket or a partial write. Every read is
        //    bounded by the length you pass, so a varint left mid-encoding
        //    raises at its own start offset instead of running off the buffer.
        //    Field 1's value varint begins at offset 1 and never terminates.
        int8[] cut = [ (int8) 0x08, (int8) 0x96 ];
        int64 where = (int64) 0 - (int64) 1;
        try {
            ProtobufIndex bad = ProtobufIndex.build(cut, (int64) 2);
        } catch (ProtobufParseException pe) {
            where = pe.position;
        }
        this.check(where == (int64) 1,
            "a truncated varint raises at the offset it started");

        // A length prefix promising more than the message carries is rejected
        // too — the index never hands out bounds it cannot honour.
        int8[] overrun = [ (int8) 0x12, (int8) 0x64, (int8) 0x68 ];
        boolean caught = false;
        try {
            ProtobufIndex bad = ProtobufIndex.build(overrun, (int64) 3);
        } catch (ProtobufParseException pe) {
            caught = true;
        }
        this.check(caught, "a LEN field longer than the message is rejected");

        // 9. Integer encodings. Plain VARINT sign-extends a negative to the
        //    full ten bytes, so a field that swings negative — a temperature
        //    delta, a price change — pays for it on every message. `encoding`
        //    picks protobuf's alternative: "zigzag" (sint32/sint64) folds the
        //    sign into bit 0, "fixed" (fixed32/fixed64) trades varint
        //    compactness for constant size.
        //
        //    The option is declared all-named — `@ProtoField(value = 2,
        //    encoding = "zigzag")` — because the annotation grammar takes
        //    either one unnamed value or a list of pairs, never a mix.
        TempDelta t = heap TempDelta();
        t.sensorId = (int64) 9;
        t.deltaC = 0 - 3;
        t.observedAt = (int64) 171532800;
        t.celsius = (float64) 21.5;
        int8[] tw = Protobuf.toBytes<TempDelta>(t);
        TempDelta tb = Protobuf.parse<TempDelta>(tw, (int64) tw.count());
        this.check(tb.sensorId == (int64) 9 && tb.deltaC == 0 - 3
            && tb.observedAt == (int64) 171532800,
            "zigzag and fixed fields round-trip through the typed facade");

        // 10. Floating point. A float64 field is protobuf `double` — wire type
        //     I64 holding the raw IEEE-754 bits, not a numeric conversion, so
        //     the exact value comes back. (21.5 is exactly representable, hence
        //     the direct comparison; in general compare bits, since -0.0 == 0.0
        //     and NaN != NaN.) A field type protobuf cannot carry is a compile
        //     error naming the field — never a value quietly missing.
        this.check(tb.celsius == (float64) 21.5,
            "a float64 field round-trips as protobuf double");
        boolean celsiusIsI64 = false;
        int32 ci = 0;
        ProtobufIndex cidx = ProtobufIndex.build(tw, (int64) tw.count());
        while (ci < cidx.fieldCount()) {
            if (cidx.fieldNumber(ci) == 4) {
                celsiusIsI64 = cidx.wireType(ci) == ProtobufWire.wireI64()
                    && cidx.valueEnd(ci) - cidx.valueStart(ci) == (int64) 8;
            }
            ci = ci + 1;
        }
        this.check(celsiusIsI64, "a double occupies eight bytes at wire type I64");

        // The payoff, measured: -3 as zigzag is one payload byte; as a plain
        // varint it is ten, because the sign extends all the way up.
        ProtobufWriter zz = heap ProtobufWriter();
        zz.writeZigzagField(1, (int64) 0 - (int64) 3);
        ProtobufWriter pv = heap ProtobufWriter();
        pv.writeVarintField(1, (int64) 0 - (int64) 3);
        System.stdout.println("  -3 as sint64 = " + zz.size()
            + " bytes, as int64 = " + pv.size() + " bytes");
        this.check(zz.size() == 2 && pv.size() == 11,
            "zigzag encodes a small negative in one payload byte, varint in ten");

        // Fixed-width fields carry wire type I32/I64 rather than VARINT, which
        // the index reports without decoding anything.
        ProtobufIndex tidx = ProtobufIndex.build(tw, (int64) tw.count());
        int32 fi = 0;
        boolean fixedIsI64 = false;
        while (fi < tidx.fieldCount()) {
            if (tidx.fieldNumber(fi) == 3) {
                fixedIsI64 = tidx.wireType(fi) == ProtobufWire.wireI64();
            }
            fi = fi + 1;
        }
        this.check(fixedIsI64, "an encoding=\"fixed\" int64 field rides wire type I64");

        // 11. Repeated fields. An array field is a repeated field; int8[] is
        //     the one exception, meaning `bytes`. `packed = true` collapses a
        //     numeric run into ONE length-delimited record instead of one
        //     tagged record per value — the difference between paying a tag
        //     byte per reading and paying it once for the run.
        SensorRun run = heap SensorRun();
        run.sensorId = (int64) 4;
        int32[] samples = [20, 21, 22, 21, 20];
        run.samples = samples;
        int64[] raw = [(int64) 100, (int64) 200];
        run.raw = raw;
        int8[] rw = Protobuf.toBytes<SensorRun>(run);
        SensorRun rb = Protobuf.parse<SensorRun>(rw, (int64) rw.count());
        this.check(rb.samples.count() == 5 && rb.samples[0] == 20
            && rb.samples[4] == 20 && rb.raw.count() == 2
            && rb.raw[1] == (int64) 200,
            "repeated fields round-trip, packed and unpacked alike");

        // The packed field is a single record; the unpacked one is a record per
        // element. Both are legal protobuf, and a reader takes either — so this
        // is a size choice, not a compatibility one.
        ProtobufIndex ridx = ProtobufIndex.build(rw, (int64) rw.count());
        int32 packedRecords = 0;
        int32 plainRecords = 0;
        int32 ri = 0;
        while (ri < ridx.fieldCount()) {
            if (ridx.fieldNumber(ri) == 2) { packedRecords = packedRecords + 1; }
            if (ridx.fieldNumber(ri) == 3) { plainRecords = plainRecords + 1; }
            ri = ri + 1;
        }
        System.stdout.println("  5 packed samples -> " + packedRecords
            + " record, 2 unpacked -> " + plainRecords + " records");
        this.check(packedRecords == 1 && plainRecords == 2,
            "packed collapses to one record; unpacked keeps one per element");

        // A repeated field is never null after a parse: protobuf cannot tell
        // "absent" from "empty", so absent decodes as an empty array.
        ProtobufWriter bare = heap ProtobufWriter();
        bare.writeVarintField(1, (int64) 8);
        int8[] bareBytes = bare.toBytes();
        SensorRun blank = Protobuf.parse<SensorRun>(
            bareBytes, (int64) bareBytes.count());
        this.check(blank.samples != null && blank.samples.count() == 0,
            "an absent repeated field decodes as empty, never null");
    }
}
